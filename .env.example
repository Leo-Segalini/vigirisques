# Copier vers .env à la racine du projet (jamais committer .env)
# cp .env.example .env

# --- Brevo ---
# Clé API SMTP / transactionnelle (Brevo → SMTP & API → Clés API)
BREVO_API_KEY=xkeysib-xxxxxxxx

# --- Cloudflare ---
# Token API : https://dash.cloudflare.com/profile/api-tokens
# Permissions recommandées : Account.Cloudflare Workers Scripts Edit + Account Settings Read
CLOUDFLARE_API_TOKEN=xxxxxxxx
CLOUDFLARE_ACCOUNT_ID=xxxxxxxx

# --- Optionnel ---
# Rempli automatiquement par npm run deploy:form si vide
FORM_API_URL=
FORM_TO_EMAIL=ali@iroko.io
FORM_FROM_EMAIL=contact@vigirisques.fr
